{
  "name": "bandcamp-tempo-adjust",
  "version": "0.9.6",
  "description": "A browser extension to detect and adjust track tempo on Bandcamp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/azarbayejani/bandcamp-tempo-adjust.git"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox --mv3",
    "submit": "wxt submit",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox --mv3",
    "postinstall": "wxt prepare",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@json2csv/plainjs": "^7.0.8",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tempo-adjust/permissions": "workspace:*",
    "@tempo-adjust/player-components": "workspace:*",
    "@tempo-adjust/theme-provider": "workspace:*",
    "@tempo-adjust/to-one-decimal": "workspace:*",
    "@wxt-dev/webextension-polyfill": "catalog:",
    "immer": "^9.0.21",
    "p-queue": "^8.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-select": "^5.10.2",
    "web-audio-beat-detector": "^8.2.39",
    "webextension-polyfill": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tempo-adjust/wxt-hooks": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/webextension-polyfill": "catalog:",
    "@webext-core/fake-browser": "^1.5.2",
    "@wxt-dev/module-react": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "web-ext": "catalog:",
    "wxt": "catalog:"
  },
  "browserslist": "> 0.5%, last 5 versions, not dead"
}
