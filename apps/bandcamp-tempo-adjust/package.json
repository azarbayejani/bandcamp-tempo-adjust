    "@tempo-adjust/to-one-decimal": "workspace:*",
    "@wxt-dev/webextension-polyfill": "^1.0.0",
    "immer": "^9.0.21",
    "p-queue": "^8.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-select": "^5.10.2",
