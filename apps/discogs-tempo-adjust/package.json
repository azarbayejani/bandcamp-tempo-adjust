{
  "name": "discogs-tempo-adjust",
  "version": "0.1.3",
  "description": "A browser extension to detect and adjust track tempo on Discogs",
  "author": "Bobby Azarbayejani <bobby@azarbayejani.com>",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tempo-adjust/wxt-hooks": "workspace:*",
    "@types/har-format": "^1.2.16",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/webextension-polyfill": "catalog:",
    "@wxt-dev/module-react": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "web-ext": "catalog:",
    "wxt": "catalog:"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "postinstall": "wxt prepare",
    "check": "tsc && tsc -p e2e",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tempo-adjust/permissions": "workspace:*",
    "@tempo-adjust/player-components": "workspace:*",
    "@tempo-adjust/theme-provider": "workspace:*",
    "@wxt-dev/webextension-polyfill": "catalog:",
    "classnames": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "webextension-polyfill": "catalog:",
    "zustand": "catalog:"
  },
  "type": "module"
}
