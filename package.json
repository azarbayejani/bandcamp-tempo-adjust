{
  "name": "@tempo-adjust/monorepo",
  "version": "0.1",
  "description": "A browser extension to detect and adjust track tempo on the web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/azarbayejani/bandcamp-tempo-adjust.git"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "check": "pnpm -r exec tsc",
    "dev:bandcamp": "pnpm --filter bandcamp-tempo-adjust dev",
    "dev:discogs": "pnpm --filter discogs-tempo-adjust dev",
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "pnpm --filter './apps/**' build",
    "build:firefox": "pnpm --filter './apps/**' build -b firefox --mv3",
    "test": "vitest",
    "zip": "pnpm zip:chrome && pnpm zip:firefox",
    "zip:chrome": "pnpm --filter './apps/**' zip",
    "zip:firefox": "pnpm --filter './apps/**' zip -b firefox --mv3",
    "submit:bandcamp": "pnpm --filter bandcamp-tempo-adjust submit",
    "e2e": "pnpm -r e2e",
    "e2e:ui": "pnpm -r e2e:ui"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/chrome": "^0.0.202",
    "@types/json2csv": "^5.0.7",
    "@types/react": "18.3.1",
    "@types/react-dom": "^18.3.7",
    "@types/webextension-polyfill": "^0.9.2",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fs-extra": "^11.4.0",
    "jsdom": "27.4.0",
    "prettier": "^2.8.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rimraf": "^6.1.3",
    "sass": "^1.103.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "@types/react": "18.3.1"
  },
  "pnpm": {
    "overrides": {
      "node-forge": "^1.4.0",
      "shell-quote": ">=1.9.0",
      "adm-zip": "^0.6.0",
      "tmp": ">=0.2.6",
      "uuid@<11.1.1": ">=11.1.1"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "less",
        "stylus",
        "sugarss",
        "lightningcss",
        "sass-embedded"
      ]
    }
  },
  "packageManager": "pnpm@9.12.3"
}
