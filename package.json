{
  "name": "@tempo-adjust/monorepo",
  "version": "0.1",
  "description": "A browser extension to detect and adjust track tempo on the web",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/azarbayejani/bandcamp-tempo-adjust.git"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "check": "pnpm -r exec tsc",
    "lint": "eslint .",
    "dev:bandcamp": "pnpm --filter bandcamp-tempo-adjust dev",
    "dev:discogs": "pnpm --filter discogs-tempo-adjust dev",
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "pnpm --filter './apps/**' build",
    "build:firefox": "pnpm --filter './apps/**' build -b firefox --mv3",
    "test": "vitest",
    "zip": "pnpm zip:chrome && pnpm zip:firefox",
    "zip:chrome": "pnpm --filter './apps/**' zip",
    "zip:firefox": "pnpm --filter './apps/**' zip -b firefox --mv3",
    "submit:bandcamp": "pnpm --filter bandcamp-tempo-adjust submit",
    "e2e": "pnpm -r e2e",
    "e2e:ui": "pnpm -r e2e:ui"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/chrome": "^0.0.202",
    "@types/json2csv": "^5.0.7",
    "@types/react": "18.3.1",
    "@types/react-dom": "^18.3.7",
    "@types/webextension-polyfill": "^0.9.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fs-extra": "^11.4.0",
    "globals": "^17.11.0",
    "jsdom": "27.4.0",
    "prettier": "^2.8.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rimraf": "^6.1.3",
    "sass": "^1.103.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "@types/react": "18.3.1"
  },
  "packageManager": "pnpm@10.34.5"
}
