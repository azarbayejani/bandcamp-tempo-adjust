{
  "version": 1,
  "name": "Tempo Adjust",
  "publicDir": "public",
  "command": "pnpm exec open-assets render",
  "tags": [
    {
      "id": "screenshots",
      "label": "Screenshots"
    },
    {
      "id": "iphone",
      "label": "iPhone"
    },
    {
      "id": "mac",
      "label": "Mac"
    },
    {
      "id": "ipad",
      "label": "iPad"
    }
  ],
  "collections": [
    {
      "id": "iphone",
      "label": "iPhone App Store screenshots",
      "tags": [
        "screenshots",
        "iphone"
      ],
      "sourceSize": {
        "width": 440,
        "height": 956
      },
      "borderRadius": 4,
      "templates": [
        {
          "src": "templates/iphone/01-hero.html",
          "name": "01-hero",
          "label": "Hear tracks at your tempo"
        },
        {
          "src": "templates/iphone/02-bpm.html",
          "name": "02-bpm",
          "label": "Know the BPM"
        },
        {
          "src": "templates/iphone/03-range.html",
          "name": "03-range",
          "label": "Tempo ranges"
        },
        {
          "src": "templates/iphone/04-master-tempo.html",
          "name": "04-master-tempo",
          "label": "Master tempo"
        },
        {
          "src": "templates/iphone/05-tap.html",
          "name": "05-tap",
          "label": "Tap BPM"
        },
        {
          "src": "templates/iphone/06-discogs.html",
          "name": "06-discogs",
          "label": "Discogs too"
        },
        {
          "src": "templates/iphone/07-purchases.html",
          "name": "07-purchases",
          "label": "Export your purchases"
        }
      ],
      "export": [
        {
          "name": "6.9",
          "label": "iPhone 6.9\"",
          "size": {
            "width": 1320,
            "height": 2868
          }
        },
        {
          "name": "6.3",
          "label": "iPhone 6.3\"",
          "size": {
            "width": 1206,
            "height": 2622
          }
        }
      ],
      "customExport": {
        "defaultWidth": 1320,
        "defaultHeight": 2868
      }
    },
