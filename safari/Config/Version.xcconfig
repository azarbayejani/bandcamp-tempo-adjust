// Versions for the app and its extension. Both targets inherit these through
// Shared.xcconfig; App Store Connect rejects builds where they differ.

// Must equal "version" in apps/bandcamp-tempo-adjust/package.json, which is
// the single source for every store. Don't edit by hand: when package.json
// changes, the next Xcode build rewrites this line and fails once so you
// rebuild and commit it.
MARKETING_VERSION = 2026.10.0

// Build number. Bump it by hand for every upload to App Store Connect; it
// must increase even when MARKETING_VERSION stays the same.
CURRENT_PROJECT_VERSION = 2
